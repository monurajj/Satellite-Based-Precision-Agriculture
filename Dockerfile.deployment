# Composite Dockerfile for Node.js + Python + Static Frontend
FROM python:3.9-slim-buster

# Install Node.js 18
RUN apt-get update && apt-get install -y \
    curl \
    gnupg \
    && curl -sL https://deb.nodesource.com/setup_18.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies
COPY requirements-minimal.txt .
RUN pip install --no-cache-dir -r requirements-minimal.txt || \
    pip install --no-cache-dir pandas numpy scikit-learn xgboost joblib scipy

# Copy the entire project
COPY . .

# Build the Frontend
WORKDIR /app/crop-prediction-webapp/frontend
RUN npm install && npm run build

# Setup the Backend
WORKDIR /app/crop-prediction-webapp/backend
RUN npm install

# Retrain models if they don't exist (ensures the app works immediately)
WORKDIR /app
RUN python Phase1_ML/main.py --quick || echo "Phase 1 models already exist or failed"
RUN python Phase3_Hybrid/src/retrain_all_india.py || echo "Phase 3 models already exist or failed"

# Final environment variables
ENV PYTHONPATH=/app
ENV PORT=10000
EXPOSE 10000

# Start the Node.js backend
WORKDIR /app/crop-prediction-webapp/backend
CMD ["node", "server.js"]
