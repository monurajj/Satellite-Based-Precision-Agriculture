# Use a specialized image that has both Python 3.9 and Node.js 18 pre-installed
FROM nikolaik/python-nodejs:python3.9-nodejs18-slim

WORKDIR /app

# 1. Install Python dependencies
# We use minimal first to keep the image size down
COPY requirements-minimal.txt .
RUN pip install --no-cache-dir -r requirements-minimal.txt || \
    pip install --no-cache-dir pandas numpy scikit-learn xgboost joblib scipy

# 2. Copy the entire project
COPY . .

# 3. Build the Frontend
WORKDIR /app/crop-prediction-webapp/frontend
RUN npm install && npm run build

# 4. Setup the Backend
WORKDIR /app/crop-prediction-webapp/backend
RUN npm install

# 5. Pre-train/generate models (so the app works immediately)
WORKDIR /app
RUN python Phase1_ML/main.py --quick || echo "Phase 1 skip"
# Note: Phase 3 training might be heavy; we ensure minimal models exist
RUN python Phase3_Hybrid/src/retrain_all_india.py || echo "Phase 3 skip"

# Final environment settings
ENV PYTHONPATH=/app
ENV PORT=10000
EXPOSE 10000

# Start the Node.js backend
WORKDIR /app/crop-prediction-webapp/backend
CMD ["node", "server.js"]
